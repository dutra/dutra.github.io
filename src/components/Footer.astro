---
import { site } from '../data/site';
import { moonPhase } from '../lib/moon';

// Build-time value as a fallback; the script below replaces it with today's phase in the browser.
const fallback = moonPhase().label;
---

<footer class="foot">
  <div class="wrap row">
    <span>© {new Date().getFullYear()} {site.name}</span>
    <span data-moon title="Moon phase today, computed in your browser">{fallback}</span>
  </div>
  <p class="wrap credit">
    Background: galaxy cluster Abell S1063 observed with JWST.{' '}
    <a href="https://esawebb.org/images/potm2505a/">Image</a>: ESA/Webb, NASA &amp; CSA, H. Atek, M. Zamani (ESA/Webb);
    acknowledgement R. Endsley. The moving galaxy, its lensed images and the curves drawn over it come from an
    illustrative lens model, not a fit to this cluster.
  </p>
</footer>

<script>
  import { moonPhase } from '../lib/moon';
  const el = document.querySelector('[data-moon]');
  if (el) el.textContent = moonPhase().label;
</script>

<style>
  .foot {
    border-top: 1px solid var(--line);
    padding-block: 26px 40px;
    font-family: var(--font-ui);
    font-size: 12.5px;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .credit {
    margin-top: 14px;
    max-width: 72ch;
    font-size: 11.5px;
    line-height: 1.6;
    letter-spacing: 0.02em;
  }
  .credit a {
    color: var(--ink-soft);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 24px;
  }
</style>
