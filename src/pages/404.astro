---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <div class="wrap lost">
    <p class="label">404</p>
    <h1>Not found</h1>
    <p>Nothing here. Try the <a href="/">front page</a>.</p>
  </div>
</Base>

<style>
  .lost {
    display: grid;
    align-content: center;
    gap: 16px;
    min-height: 70vh;
    padding-top: 80px;
  }
  h1 {
    font-size: clamp(2.4rem, 6vw, 4rem);
  }
</style>
